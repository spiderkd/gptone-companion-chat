# Ports
PORT=3000
POSTGRES_PORT=5434
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:${PORT}
NEXT_PUBLIC_API_BASE_URL=http://localhost:${PORT}/api/agent

# Postgres / Prisma
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gptone
DATABASE_URL=postgresql://user:password@localhost:${POSTGRES_PORT}/gptone?schema=public

# Optional server-side model fallbacks.
# Users can also bring their own keys through the Key Management UI.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional JEV / Codiv companion classifier fallback.
# Users can also provide this key in the browser UI.
CODIV_API_KEY=
CODIV_BASE_URL=https://api.codiv.dev/v1
CODIV_MODEL=openjev-latest

# S3-compatible object storage.
# Local development can use the service from compose.yaml.
# Production can use Cloudflare R2, AWS S3, or another compatible provider.
S3_ENDPOINT=http://localhost:${S3_API_PORT}
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# For AWS S3, usually leave S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE=false.
# For Cloudflare R2, set S3_ENDPOINT to your account endpoint and keep the bucket credentials scoped tightly.
